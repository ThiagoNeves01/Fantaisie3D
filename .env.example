# ── Banco de dados (PostgreSQL) ───────────────────────────────
# Local:
DATABASE_URL="postgresql://f3d:f3d_dev_pw@localhost:5432/fantaisie3d?schema=public"
DIRECT_URL="postgresql://f3d:f3d_dev_pw@localhost:5432/fantaisie3d?schema=public"
# Supabase (Project Settings → Database → Connection string):
#   DATABASE_URL = "Transaction pooler" (porta 6543)  ·  DIRECT_URL = "Session"/"Direct" (porta 5432, usada nas migrações)
# DATABASE_SSL="true"

# ── Aplicação ─────────────────────────────────────────────────
APP_URL="http://localhost:3000"   # URL pública (links de e-mail, canonical/hreflang, sitemap)

# ── E-mail transacional (opcional) ────────────────────────────
